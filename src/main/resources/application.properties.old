spring.application.name=login
spring.redis.host=redis
spring.redis.port=6379
spring.redis.timeout=2000ms

spring.datasource.url=jdbc:h2:mem:alunos_db;MODE=MySQL
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

jwt.secret=${JWT_SECRET:bXlTdXBlclNlY3JldEtleUZvckpXVFRva2VuR2VuZXJhdGlvbjEyMzQ1Njc4OTA=}
jwt.expiration-ms=${JWT_EXPIRATION:86400000}

server.port=8081
server.servlet.context-path=/api/v1

logging.level.com.br.itau.login=DEBUG

management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always
